    "max_position_embeddings": 65536,
    "rope_theta": 500000.0,
    "window_size": null,
    "hidden_act": "swish",
    "norm_eps": 1e-05,
    "initializer_range": 0.02,
    "tie_word_embeddings": true,
    "qkv_bias": false,
    "qk_norm": false,
