    "fuse_swiglu": true,
    "fuse_cross_entropy": false,
    "fuse_linear_cross_entropy": true,
    "use_cache": true,
    "bos_token_id": 128000,
    "eos_token_id": 128001,
    "ttt_mode": true,
    "ttt_layers": [0, 5, 10, 15],
    "ttt_chunk": 4096,
    "ttt_lr": 0.3,
    "ttt_proj": true,
    "ttt_proj_init": "diagonal_gaussian",
    "ttt_target": "hidden",
