{
    "model_type": "ipttcdv9",
    "hidden_size": 960,
    "num_hidden_layers": 32,
    "num_heads": 15,
    "num_kv_heads": 5,
    "head_dim": 64,
    "intermediate_size": 2560,
    "vocab_size": 49152,
    "max_position_embeddings": 65536,
    "rope_theta": 100000.0,
    "window_size": 4096,
    "hidden_act": "swish",
    "norm_eps": 1e-05,
    "initializer_range": 0.02,
    "tie_word_embeddings": true,
    "qkv_bias": false,
    "qk_norm": false,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": false,
    "fuse_linear_cross_entropy": true,
    "use_cache": true,
    "bos_token_id": 0,
    "eos_token_id": 0,
    "ttt_mode": true,
    "ttt_layers": [0, 8, 16, 24],
    "ttt_chunk": 1024,
    "ttt_lr": 0.3,
    "ttt_proj": true,
    "ttt_proj_init": "diagonal",
    "ttt_conv": true,
    "ttt_teacher_conv": true,
    "ttt_student_conv": true,
    "ttt_output_use_teacher_conv": true,
    "ttt_conv_kernel_size": 5,
    "ttt_conv_causal": true,
    "dynamic_lr": true,
    "ttt_visible_chunks": 2,
    "ttt_update_every": 16,
    "ttt_force_grouped_scan": true,
    "ttt_weight_renorm": false,
    "use_muon": false
